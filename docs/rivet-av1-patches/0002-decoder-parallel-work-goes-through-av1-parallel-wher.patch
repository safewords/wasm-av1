--- /dev/null
+++ b/src/parallel.rs
@@ -0,0 +1,84 @@
+//! Where the threads come from.
+//!
+//! With [`Decoder::set_threads`](crate::Decoder::set_threads) above one,
+//! the decoder hands the tiles of a frame and the bands of its post-filters
+//! to several threads at once. By default those are scoped threads of the
+//! standard library, started for the job and joined after it.
+//!
+//! Some targets have no `std::thread::spawn`: on `wasm32-unknown-unknown` a
+//! thread is another instance of the module on the same shared memory,
+//! which only the embedder (the page's JavaScript) can create. Such an
+//! embedder registers a [`Runner`] once with [`set_runner`] — typically a
+//! pool of threads it started itself and keeps — and the decoder runs its
+//! parallel work through it instead.
+
+use std::sync::OnceLock;
+
+/// Runs one job on several threads at once.
+pub trait Runner: Send + Sync {
+    /// Calls `job(0)` on the calling thread and `job(k)` for `k` in `1..n`
+    /// on other threads, each `k` at most once and at the same time as the
+    /// others, and returns when every call it made has returned.
+    ///
+    /// The job is a loop that takes work off a shared queue until none is
+    /// left, so a runner may leave out any of `1..n` (a thread that is not
+    /// there yet, or busy): the calls it does make finish the work between
+    /// them. It must not return while a call is still running — the job
+    /// borrows from the caller's stack.
+    fn run(&self, n: usize, job: &(dyn Fn(usize) + Sync));
+}
+
+static RUNNER: OnceLock<&'static dyn Runner> = OnceLock::new();
+
+/// Registers the process's [`Runner`]. The first registration stays;
+/// returns whether this was it.
+pub fn set_runner(runner: &'static dyn Runner) -> bool {
+    RUNNER.set(runner).is_ok()
+}
+
+/// Runs `job(k)` for `k` in `0..n` at once, `job(0)` on the calling thread:
+/// through the registered [`Runner`], else on scoped threads.
+pub(crate) fn run(n: usize, job: &(dyn Fn(usize) + Sync)) {
+    if n <= 1 {
+        return job(0);
+    }
+    match RUNNER.get() {
+        Some(r) => r.run(n, job),
+        None => std::thread::scope(|s| {
+            for k in 1..n {
+                s.spawn(move || job(k));
+            }
+            job(0);
+        }),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    #[test]
+    fn scoped_threads_call_every_index_once() {
+        let calls: Vec<AtomicUsize> = (0..6).map(|_| AtomicUsize::new(0)).collect();
+        let caller = std::thread::current().id();
+        run(6, &|k| {
+            calls[k].fetch_add(1, Ordering::Relaxed);
+            assert_eq!(k == 0, std::thread::current().id() == caller);
+        });
+        assert!(calls.iter().all(|c| c.load(Ordering::Relaxed) == 1));
+    }
+
+    #[test]
+    fn one_worker_is_the_caller_alone() {
+        let n = AtomicUsize::new(0);
+        run(1, &|k| {
+            assert_eq!(k, 0);
+            n.fetch_add(1, Ordering::Relaxed);
+        });
+        run(0, &|_| {
+            n.fetch_add(1, Ordering::Relaxed);
+        });
+        assert_eq!(n.load(Ordering::Relaxed), 2);
+    }
+}
diff --git a/tests/parallel.rs b/tests/parallel.rs
new file mode 100644
index 0000000..fb5d477
--- /dev/null
+++ b/tests/parallel.rs
@@ -0,0 +1,79 @@
+//! A registered [`av1::parallel::Runner`] (what an embedder without
+//! `std::thread::spawn` provides) decodes the committed vectors exactly:
+//! one that starts every thread it is asked for, and one that starts none
+//! and leaves the caller's own call to finish the work. A test binary of
+//! its own: the runner is registered once for the process.
+
+mod common;
+
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+/// Runs the extra calls on scoped threads, or (`ALONE`) not at all.
+struct Switchable;
+
+static ALONE: AtomicBool = AtomicBool::new(false);
+static RUNS: AtomicUsize = AtomicUsize::new(0);
+static EXTRA_CALLS: AtomicUsize = AtomicUsize::new(0);
+
+impl av1::parallel::Runner for Switchable {
+    fn run(&self, n: usize, job: &(dyn Fn(usize) + Sync)) {
+        RUNS.fetch_add(1, Ordering::Relaxed);
+        if ALONE.load(Ordering::Relaxed) {
+            return job(0);
+        }
+        std::thread::scope(|s| {
+            for k in 1..n {
+                s.spawn(move || {
+                    EXTRA_CALLS.fetch_add(1, Ordering::Relaxed);
+                    job(k)
+                });
+            }
+            job(0);
+        });
+    }
+}
+
+fn decode_committed(threads: usize) -> usize {
+    let dir = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/data");
+    let mut frames = 0;
+    for path in common::vectors_in(&dir) {
+        let expected = common::expected_md5s(&path);
+        let mut dec = av1::Decoder::new();
+        dec.set_threads(threads);
+        let mut n = 0;
+        for p in common::packets(&path) {
+            if let Some(f) = dec.decode(&p).unwrap() {
+                assert_eq!(
+                    expected.get(n),
+                    Some(&common::frame_md5(&f)),
+                    "{}: frame {n}",
+                    path.display()
+                );
+                n += 1;
+            }
+        }
+        assert_eq!(n, expected.len(), "{}", path.display());
+        frames += n;
+    }
+    frames
+}
+
+#[test]
+fn a_registered_runner_decodes_exactly() {
+    static RUNNER: Switchable = Switchable;
+    assert!(av1::parallel::set_runner(&RUNNER));
+    assert!(!av1::parallel::set_runner(&RUNNER), "the first stays");
+
+    let frames = decode_committed(4);
+    assert!(frames > 0);
+    let runs = RUNS.load(Ordering::Relaxed);
+    assert!(runs > 0, "the decoder went through the runner");
+    assert!(EXTRA_CALLS.load(Ordering::Relaxed) > 0);
+
+    // A runner whose threads are not there: the caller's call does it all.
+    ALONE.store(true, Ordering::Relaxed);
+    let extra = EXTRA_CALLS.load(Ordering::Relaxed);
+    assert_eq!(decode_committed(4), frames);
+    assert!(RUNS.load(Ordering::Relaxed) > runs);
+    assert_eq!(EXTRA_CALLS.load(Ordering::Relaxed), extra);
+}
